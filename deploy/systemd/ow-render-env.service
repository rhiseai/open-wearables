[Unit]
Description=Render OpenWearables staging env files from AWS Secrets Manager
Documentation=https://linear.app/rhiseai/issue/RHISE-3839
After=network-online.target
Wants=network-online.target
# Ordered before Docker so the files on disk are never stale when the daemon
# comes back. It does NOT push a rotated value into a running container:
# compose bakes env_file into each container when it is created, and a reboot
# only starts the containers that already exist. A rotated credential reaches
# the stack when the next deploy recreates them — the same as prod, where ECS
# reads Secrets Manager at task start.
#
# Ordering only: if Secrets Manager is unreachable the render fails, the
# previous files stay on disk, and the stack still starts on the values it had.
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/app/deploy/scripts/render-env.sh

[Install]
WantedBy=multi-user.target
