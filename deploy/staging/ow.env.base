# Non-secret staging configuration for the OpenWearables backend.
#
# render-env.sh copies this file verbatim and appends the credentials it reads
# from AWS Secrets Manager (lucie-staging/ow/*) to produce /app/ow.env. Nothing
# in here is a secret, which is why it is committed: the deploy workflow ships
# code, image tags and the public hostname, and nothing else.
#
# Values that are the same in every environment belong in the image. Values
# that differ per environment but are not secret belong here. Values that are
# secret belong in Secrets Manager and appear in the table in render-env.sh.

OUTGOING_WEBHOOKS_ENABLED=True

# Single-domain path routing. Traefik terminates TLS via Let's Encrypt at
# ``ow-staging.getlucie.ai``; ``/api/*`` is stripped and forwarded to ow-api,
# ``/*`` serves the dashboard. Whoop/Oura receive redirect_uri rooted at
# ``/api`` below.
API_BASE_URL=https://ow-staging.getlucie.ai
SERVER_HOST=https://ow-staging.getlucie.ai
FRONTEND_URL=https://ow-staging.getlucie.ai
CORS_ORIGINS=["https://ow-staging.getlucie.ai"]

# Email
EMAIL_FROM_ADDRESS=noreply@getlucie.ai
EMAIL_FROM_NAME=Open Wearables

# Sentry (hardcoded disabled on staging)
SENTRY_ENABLED=False
SENTRY_ENV=staging

# AWS (staging) — the EC2 instance role handles auth, no access keys
AWS_REGION=eusc-de-east-1
AWS_BUCKET_NAME=getlucie-ow-xml-staging
AWS_SNS_TOPIC_ARN=arn:aws-eusc:sns:eusc-de-east-1:326876515198:owear-staging

# Provider scopes
OURA_DEFAULT_SCOPE=personal daily activity heartrate workout session spo2 ring_configuration heart_health
WHOOP_DEFAULT_SCOPE=offline read:cycles read:sleep read:recovery read:workout read:body_measurement read:profile

# Sync
SYNC_INTERVAL_SECONDS=3600
